# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local tooling (not part of the site)
.agents/
.claude/
skills-lock.json

# unused raw intro frames (not referenced by the app — public/intro-sequence is what's actually loaded)
/ezgif-45fa0bce168d47c4-jpg
# raw screenshot folders: only the images shown on the site are committed
/public/voice-form ss/*
!/public/voice-form ss/10.review-detected-fields.png
!/public/voice-form ss/13.voice-asking-field.png
!/public/voice-form ss/14.form-verification-complete.png
/public/projectmind ss/*
!/public/projectmind ss/2.semantic-search-results.png
!/public/projectmind ss/6.project-detail.png
/public/fileflow ss/*
!/public/fileflow ss/dashboard-light.png
!/public/fileflow ss/rules-light.png
